# ---------------------------------------------------------------------------
# GutWise environment variables — TEMPLATE ONLY
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. In production, set these in the Cloudflare Pages project under
# Settings -> Environment variables (mark secrets as "Encrypted").
#
# Anything prefixed PUBLIC_ is inlined into the client bundle and is therefore
# world-readable. Never put a secret behind a PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Canonical origin -------------------------------------------------------
# Overridden per-environment so preview branches emit correct absolute URLs.
SITE_URL="https://gutwise.nexudel.com"

# --- Analytics (public by design) ------------------------------------------
# GA4 Measurement ID. Leave blank to omit the GA4 snippet entirely.
PUBLIC_GA4_ID=""
# Cloudflare Web Analytics token. Leave blank to omit the beacon entirely.
PUBLIC_CF_BEACON_TOKEN=""

# --- Cloudflare Turnstile (bot protection on forms) ------------------------
# Site key is public and rendered in the widget.
PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key is SERVER-ONLY. Consumed by functions/api/contact.ts via the
# Pages Functions runtime binding. Never expose it to the client.
TURNSTILE_SECRET_KEY=""

# --- Email capture (public embed identifiers) ------------------------------
# ConvertKit form endpoint, e.g. https://app.kit.com/forms/1234567/subscriptions
PUBLIC_NEWSLETTER_ACTION=""

# --- Contact form delivery -------------------------------------------------
# Where validated contact submissions are forwarded. SERVER-ONLY.
# Either a Formspree endpoint or any HTTPS webhook that accepts JSON.
CONTACT_FORWARD_ENDPOINT=""
