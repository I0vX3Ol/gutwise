---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FodmapTag from '../../components/FodmapTag.astro';
import Callout from '../../components/Callout.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import Icon from '../../components/Icon.astro';
import { FODMAP_LEVELS } from '../../consts';
import {
	formatDate,
	formatDuration,
	isoDate,
	phaseLabel,
	sortPhases,
	titleCase,
	sortMealTypes,
	publishedOnly,
} from '../../lib/utils';
import { breadcrumbSchema, recipeSchema } from '../../lib/schema';

interface Props {
	recipe: CollectionEntry<'recipes'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
	const recipes = publishedOnly(await getCollection('recipes'));
	return recipes.map((recipe) => ({
		params: { slug: recipe.id },
		props: { recipe },
	}));
};

const { recipe } = Astro.props;
const { data } = recipe;
const { Content } = await render(recipe);

const total = data.prepMinutes + data.cookMinutes;
const url = `/recipes/${recipe.id}/`;

const crumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Recipes', href: '/recipes/' },
	{ label: data.title, href: url },
];

// Pull the linked guides so the recipe -> guide mesh is real, not decorative.
const related = (
	await Promise.all(data.relatedGuides.map((id) => getEntry('guides', id)))
).filter((g): g is NonNullable<typeof g> => Boolean(g));

/** Which FODMAP levels actually appear, so the key only explains what is used. */
const levelsPresent = [...new Set(data.ingredients.map((i) => i.fodmap))].sort(
	(a, b) =>
		['safe', 'moderate', 'high'].indexOf(a) - ['safe', 'moderate', 'high'].indexOf(b),
);
---

<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.description}
	ogType="article"
	publishedTime={data.publishDate}
	modifiedTime={data.updatedDate}
	schemaNodes={[breadcrumbSchema(crumbs), recipeSchema(data, url)]}
>
	<article>
		<div class="border-b border-cream-border bg-cream-sunken">
			<div class="mx-auto max-w-6xl px-5 py-8 sm:py-12">
				<Breadcrumbs crumbs={crumbs} class="mb-6" />

				<div class="grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start">
					<div>
						<ul class="flex flex-wrap gap-1.5">
							{
								sortPhases(data.phases).map((phase) => (
									<li class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-sage-deep">
										{phaseLabel(phase)}
									</li>
								))
							}
							{
								sortMealTypes(data.mealTypes).map((meal) => (
									<li class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-sage-deep">
										{titleCase(meal)}
									</li>
								))
							}
						</ul>

						<h1 class="mt-4 font-display text-3xl font-semibold text-sage-deep sm:text-4xl md:text-5xl">
							{data.title}
						</h1>

						<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">
							{data.summary}
						</p>

						<!-- At-a-glance facts -->
						<dl class="mt-7 grid grid-cols-2 gap-4 sm:grid-cols-4">
							{
								[
									{ label: 'Prep', value: formatDuration(data.prepMinutes), icon: 'clock' },
									{ label: 'Cook', value: formatDuration(data.cookMinutes), icon: 'clock' },
									{ label: 'Total', value: formatDuration(total), icon: 'clock' },
									{ label: 'Serves', value: String(data.servings), icon: 'users' },
								].map((fact) => (
									<div class="rounded-card bg-white p-3">
										<dt class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-sage">
											<Icon name={fact.icon as 'clock'} size={13} />
											{fact.label}
										</dt>
										<dd class="mt-1 font-display text-lg font-semibold text-sage-deep">
											{fact.value}
										</dd>
									</div>
								))
							}
						</dl>

						<p class="mt-5 text-sm text-ink-muted">
							Published <time datetime={isoDate(data.publishDate)}>{formatDate(data.publishDate)}</time>
							{
								data.updatedDate && (
									<>
										{' · Updated '}
										<time datetime={isoDate(data.updatedDate)}>
											{formatDate(data.updatedDate)}
										</time>
									</>
								)
							}
						</p>
					</div>

					<img
						src={data.image}
						alt={data.imageAlt}
						width="720"
						height="480"
						fetchpriority="high"
						decoding="async"
						class="aspect-[3/2] w-full rounded-card bg-white object-cover"
					/>
				</div>
			</div>
		</div>

		<div class="mx-auto max-w-6xl px-5 py-12">
			<!-- The serving ceiling is the single most important fact on the page,
			     so it sits above both the ingredients and the method. -->
			<Callout variant="note" title="The serving size that keeps this low FODMAP">
				<p>{data.servingSizeNote}</p>
			</Callout>

			<div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
				<div>
					<!-- Ingredients -->
					<section aria-labelledby="ingredients">
						<h2 id="ingredients" class="font-display text-2xl font-semibold text-sage-deep">
							Ingredients
						</h2>
						<p class="mt-1.5 text-sm text-ink-muted">
							Makes {data.servings} {data.yieldLabel}. Each ingredient is labelled
							with its FODMAP status at this quantity.
						</p>

						<ul class="mt-5 divide-y divide-cream-border border-y border-cream-border">
							{
								data.ingredients.map((ing) => (
									<li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 py-3.5">
										<div class="min-w-0 flex-1">
											<p class="text-ink">
												<span class="font-semibold">{ing.amount}</span> {ing.item}
											</p>
											{ing.note && (
												<p class="mt-1 text-sm leading-relaxed text-ink-muted">{ing.note}</p>
											)}
										</div>
										<FodmapTag level={ing.fodmap} class="shrink-0" />
									</li>
								))
							}
						</ul>

						<!-- Key for the badges used above. Icon + text, never colour alone. -->
						<div class="mt-5 rounded-card bg-cream-sunken p-4">
							<h3 class="text-sm font-semibold text-sage-deep">What the labels mean</h3>
							<ul class="mt-3 space-y-2">
								{
									levelsPresent.map((level) => (
										<li class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
											<FodmapTag level={level} />
											<span>{FODMAP_LEVELS[level].description}</span>
										</li>
									))
								}
							</ul>
						</div>
					</section>

					<!-- Method -->
					<section aria-labelledby="method" class="mt-12">
						<h2 id="method" class="font-display text-2xl font-semibold text-sage-deep">
							Method
						</h2>
						<ol class="mt-5 space-y-5">
							{
								data.instructions.map((step, i) => (
									<li class="flex gap-4">
										<span
											aria-hidden="true"
											class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sage-deep font-semibold text-cream"
										>
											{i + 1}
										</span>
										<p class="leading-relaxed text-ink">
											<span class="sr-only-focusable">Step {i + 1}: </span>
											{step}
										</p>
									</li>
								))
							}
						</ol>
					</section>

					{
						data.tips.length > 0 && (
							<section aria-labelledby="tips" class="mt-12">
								<h2 id="tips" class="font-display text-2xl font-semibold text-sage-deep">
									Notes and swaps
								</h2>
								<ul class="mt-4 space-y-3">
									{data.tips.map((tip) => (
										<li class="flex gap-3 leading-relaxed text-ink">
											<span class="mt-1 shrink-0 text-sage">
												<Icon name="check" size={16} />
											</span>
											<span>{tip}</span>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<!-- Author's markdown body -->
					<div class="prose prose-gutwise mt-12">
						<Content />
					</div>
				</div>

				<!-- Sidebar -->
				<aside class="space-y-6 lg:sticky lg:top-24">
					<section class="card p-5" aria-labelledby="why-safe">
						<h2 id="why-safe" class="font-display text-lg font-semibold text-sage-deep">
							Why this is low FODMAP
						</h2>
						<p class="mt-2 text-[0.925rem] leading-relaxed text-ink-muted">
							{data.fodmapNotes}
						</p>
					</section>

					{
						data.nutrition && (
							<section class="card p-5" aria-labelledby="nutrition">
								<h2 id="nutrition" class="font-display text-lg font-semibold text-sage-deep">
									Per serving
								</h2>
								<dl class="mt-3 space-y-2 text-[0.925rem]">
									{Object.entries({
										Calories: data.nutrition.calories,
										Protein: data.nutrition.protein,
										Carbohydrate: data.nutrition.carbs,
										Fat: data.nutrition.fat,
										Fibre: data.nutrition.fiber,
									})
										.filter(([, value]) => Boolean(value))
										.map(([label, value]) => (
											<div class="flex justify-between gap-4 border-b border-cream-border pb-2 last:border-0">
												<dt class="text-ink-muted">{label}</dt>
												<dd class="font-semibold text-sage-deep">{value}</dd>
											</div>
										))}
								</dl>
								<p class="mt-3 text-xs leading-relaxed text-ink-muted">
									Estimates only, calculated from standard ingredient values.
								</p>
							</section>
						)
					}

					<button type="button" id="print-recipe" class="btn btn-secondary w-full text-sm">
						<Icon name="book" size={16} />
						Print this recipe
					</button>
				</aside>
			</div>

			{
				related.length > 0 && (
					<section aria-labelledby="related" class="mt-16">
						<h2 id="related" class="font-display text-2xl font-semibold text-sage-deep">
							Read next
						</h2>
						<div class="mt-6 grid gap-6 sm:grid-cols-2">
							{related.map((guide) => (
								<ContentCard
									href={`/guides/${guide.id}/`}
									title={guide.data.title}
									summary={guide.data.summary}
									eyebrow="Guide"
									meta={[`${guide.data.readingMinutes} min read`]}
								/>
							))}
						</div>
					</section>
				)
			}

			<div class="mt-16">
				<EmailSignup id="starter-kit" />
			</div>
		</div>
	</article>
</BaseLayout>

<script>
	document.getElementById('print-recipe')?.addEventListener('click', () => window.print());
</script>
