---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FundingNote from '../../components/FundingNote.astro';
import FodmapTag from '../../components/FodmapTag.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, isoDate, publishedOnly } from '../../lib/utils';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
	const roundups = publishedOnly(await getCollection('products'));
	return roundups.map((roundup) => ({
		params: { slug: roundup.id },
		props: { roundup },
	}));
};

interface Props {
	roundup: CollectionEntry<'products'>;
}

const { roundup } = Astro.props;
const { data } = roundup;
const { Content } = await render(roundup);

const url = `/product-recommendations/${roundup.id}/`;
const crumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Product Picks', href: '/product-recommendations/' },
	{ label: data.title, href: url },
];

const relatedGuides = (
	await Promise.all(data.relatedGuides.map((id) => getEntry('guides', id)))
).filter((g): g is NonNullable<typeof g> => Boolean(g));

const schemaNodes: object[] = [
	breadcrumbSchema(crumbs),
	articleSchema(data, url),
];
if (data.faqs.length > 0) schemaNodes.push(faqSchema(data.faqs));

const priceLabel: Record<string, string> = {
	$: 'Budget',
	$$: 'Mid-range',
	$$$: 'Premium',
};
---

<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.description}
	ogType="article"
	publishedTime={data.publishDate}
	modifiedTime={data.updatedDate}
	schemaNodes={schemaNodes}
>
	<article>
		<div class="border-b border-cream-border bg-cream-sunken">
			<div class="mx-auto max-w-4xl px-5 py-8 sm:py-12">
				<Breadcrumbs crumbs={crumbs} class="mb-6" />

				<p class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-sage-deep">
					Buying guide
				</p>

				<h1 class="mt-4 font-display text-3xl font-semibold text-sage-deep sm:text-4xl md:text-5xl">
					{data.title}
				</h1>

				<p class="mt-4 text-lg leading-relaxed text-ink-muted">{data.summary}</p>

				<p class="mt-6 text-sm text-ink-muted">
					Last reviewed{' '}
					<time datetime={isoDate(data.lastReviewed)}>{formatDate(data.lastReviewed)}</time>
					{' · '}{data.picks.length} products assessed
				</p>
			</div>
		</div>

		<div class="mx-auto max-w-4xl px-5 py-12">
			<!-- Funding transparency, above the fold and before the first outbound link -->
			<FundingNote class="mb-10" />

			<div class="prose prose-gutwise">
				<Content />
			</div>

			<!-- The picks -->
			<section aria-labelledby="picks" class="mt-14">
				<h2 id="picks" class="font-display text-2xl font-semibold text-sage-deep">
					The picks
				</h2>

				<ol class="mt-6 space-y-6">
					{
						data.picks.map((pick, i) => (
							<li class="card overflow-hidden">
								<div class="border-b border-cream-border bg-cream-sunken px-5 py-4">
									<div class="flex flex-wrap items-start justify-between gap-3">
										<div>
											<p class="text-xs font-semibold uppercase tracking-wide text-sage">
												{i + 1}. Best for {pick.bestFor}
											</p>
											<h3 class="mt-1 font-display text-xl font-semibold text-sage-deep">
												{pick.name}
											</h3>
											<p class="mt-0.5 text-sm text-ink-muted">by {pick.brand}</p>
										</div>
										<div class="flex flex-wrap items-center gap-2">
											<FodmapTag level={pick.fodmap} />
											<span class="rounded-full border border-cream-border bg-white px-2.5 py-1 text-xs font-semibold text-ink-muted">
												{/* Price shown as a word too, never symbol-only */}
												{pick.priceBand} · {priceLabel[pick.priceBand]}
											</span>
										</div>
									</div>

									{pick.certification && (
										<p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-trust-wash px-2.5 py-1 text-xs font-semibold text-trust">
											<Icon name="check" size={13} />
											{pick.certification}
										</p>
									)}
								</div>

								<div class="p-5">
									{/* Plain text interpolation, never set:html — content is escaped by default. */}
									<p class="leading-relaxed text-ink">{pick.why}</p>

									{pick.watchOut && (
										<p class="mt-4 flex gap-2.5 rounded-card bg-amber-wash p-3.5 text-[0.925rem] leading-relaxed text-amber">
											<span class="mt-0.5 shrink-0">
												<Icon name="alert" size={16} />
											</span>
											<span>
												<strong class="font-semibold">Watch out:</strong> {pick.watchOut}
											</span>
										</p>
									)}

									{/* Not every pick gets a link. Sending someone to a specific
									    product page for lactose-free milk or plain oats would be
									    worse advice than "buy any". No `sponsored` rel because
									    nothing here is paid — see /funding/. */}
									<p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
										{pick.url ? (
											<a
												href={pick.url}
												rel="nofollow noopener noreferrer"
												target="_blank"
												class="btn btn-primary text-sm"
											>
												Visit {pick.brand}
												<Icon name="external" size={15} />
												<span class="sr-only-focusable"> (opens in a new tab)</span>
											</a>
										) : null}
										<span class="text-sm text-ink-muted">
											<span class="font-semibold text-sage-deep">Where:</span>{' '}
											{pick.where}
										</span>
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			{
				data.faqs.length > 0 && (
					<section aria-labelledby="product-faq" class="mt-14">
						<h2 id="product-faq" class="font-display text-2xl font-semibold text-sage-deep">
							Buying questions
						</h2>
						<FaqAccordion items={data.faqs} class="mt-4" />
					</section>
				)
			}

			{
				relatedGuides.length > 0 && (
					<section aria-labelledby="product-guides" class="mt-14">
						<h2 id="product-guides" class="font-display text-2xl font-semibold text-sage-deep">
							Read next
						</h2>
						<div class="mt-6 grid gap-6 sm:grid-cols-2">
							{relatedGuides.map((guide) => (
								<ContentCard
									href={`/guides/${guide.id}/`}
									title={guide.data.title}
									summary={guide.data.summary}
									eyebrow="Guide"
									meta={[`${guide.data.readingMinutes} min read`]}
								/>
							))}
						</div>
					</section>
				)
			}

			<div class="mt-14">
				<EmailSignup id="starter-kit" />
			</div>
		</div>
	</article>
</BaseLayout>
