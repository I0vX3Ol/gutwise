---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, isoDate, phaseLabel, publishedOnly } from '../../lib/utils';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
	const guides = publishedOnly(await getCollection('guides'));
	const ordered = [...guides].sort((a, b) => a.data.order - b.data.order);

	return ordered.map((guide, i) => ({
		params: { slug: guide.id },
		props: {
			guide,
			// Sequential guides read as a path, so each one offers the next step.
			next: ordered[i + 1] ?? null,
		},
	}));
};

interface Props {
	guide: CollectionEntry<'guides'>;
	/** The next guide in protocol order, or null on the last one. */
	next: CollectionEntry<'guides'> | null;
}

const { guide, next } = Astro.props;
const { data } = guide;
const { Content, headings } = await render(guide);

const url = `/guides/${guide.id}/`;
const crumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Guides', href: '/guides/' },
	{ label: data.title, href: url },
];

const relatedRecipes = (
	await Promise.all(data.relatedRecipes.map((id) => getEntry('recipes', id)))
).filter((r): r is NonNullable<typeof r> => Boolean(r));

const relatedGuides = (
	await Promise.all(data.relatedGuides.map((id) => getEntry('guides', id)))
).filter((g): g is NonNullable<typeof g> => Boolean(g));

// Only h2s make a useful table of contents; h3s make it noisy.
const toc = headings.filter((h) => h.depth === 2);

const schemaNodes: object[] = [
	breadcrumbSchema(crumbs),
	articleSchema(data, url),
];
if (data.faqs.length > 0) schemaNodes.push(faqSchema(data.faqs));
---

<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.description}
	ogType="article"
	publishedTime={data.publishDate}
	modifiedTime={data.updatedDate}
	schemaNodes={schemaNodes}
>
	<article>
		<div class="border-b border-cream-border bg-cream-sunken">
			<div class="mx-auto max-w-4xl px-5 py-8 sm:py-12">
				<Breadcrumbs crumbs={crumbs} class="mb-6" />

				{
					data.phase && (
						<p class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-sage-deep">
							{phaseLabel(data.phase)} phase
						</p>
					)
				}

				<h1 class="mt-4 font-display text-3xl font-semibold text-sage-deep sm:text-4xl md:text-5xl">
					{data.title}
				</h1>

				<p class="mt-4 text-lg leading-relaxed text-ink-muted">{data.summary}</p>

				<p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
					<span class="inline-flex items-center gap-1.5">
						<Icon name="clock" size={14} />
						{data.readingMinutes} min read
					</span>
					<span aria-hidden="true">·</span>
					<span>
						Updated{' '}
						<time datetime={isoDate(data.updatedDate ?? data.publishDate)}>
							{formatDate(data.updatedDate ?? data.publishDate)}
						</time>
					</span>
				</p>
			</div>
		</div>

		<div class="mx-auto max-w-6xl px-5 py-12">
			<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_260px] lg:gap-12 lg:items-start">
				<div>
					{
						toc.length > 2 && (
							<nav
								aria-labelledby="toc-heading"
								class="mb-10 rounded-card border border-cream-border bg-cream-sunken p-5 lg:hidden"
							>
								<h2 id="toc-heading" class="font-display text-base font-semibold text-sage-deep">
									On this page
								</h2>
								<ol class="mt-3 space-y-2">
									{toc.map((h) => (
										<li>
											<a
												href={`#${h.slug}`}
												class="text-[0.925rem] text-trust underline decoration-1 underline-offset-4"
											>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}

					<div class="prose prose-gutwise">
						<Content />
					</div>

					{
						data.sources.length > 0 && (
							<section
								aria-labelledby="sources"
								class="mt-12 rounded-card border border-cream-border bg-cream-sunken p-6"
							>
								<h2 id="sources" class="font-display text-xl font-semibold text-sage-deep">
									How we know this
								</h2>
								<p class="mt-1.5 text-sm text-ink-muted">
									Primary sources for the guidance on this page.
								</p>
								<ul class="mt-4 space-y-2.5">
									{data.sources.map((source) => (
										<li>
											<a
												href={source.url}
												rel="noopener noreferrer nofollow"
												target="_blank"
												class="inline-flex items-center gap-1.5 text-[0.95rem] text-trust underline decoration-1 underline-offset-4"
											>
												{source.label}
												<Icon name="external" size={14} />
												<span class="sr-only-focusable"> (opens in a new tab)</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						)
					}

					{
						data.faqs.length > 0 && (
							<section aria-labelledby="guide-faq" class="mt-12">
								<h2 id="guide-faq" class="font-display text-2xl font-semibold text-sage-deep">
									Questions about this phase
								</h2>
								<FaqAccordion items={data.faqs} class="mt-4" />
							</section>
						)
					}

					{
						next && (
							<a
								href={`/guides/${next.id}/`}
								class="mt-12 flex items-center justify-between gap-4 rounded-card border-2 border-sage bg-sage-wash p-5 no-underline transition-colors hover:bg-white"
							>
								<span>
									<span class="block text-xs font-semibold uppercase tracking-wide text-sage">
										Next guide
									</span>
									<span class="mt-1 block font-display text-lg font-semibold text-sage-deep">
										{next.data.title}
									</span>
								</span>
								<Icon name="arrow-right" size={22} class="shrink-0 text-sage-deep" />
							</a>
						)
					}
				</div>

				<!-- Desktop table of contents -->
				{
					toc.length > 2 && (
						<aside class="hidden lg:block lg:sticky lg:top-24">
							<nav aria-labelledby="toc-heading-desktop">
								<h2
									id="toc-heading-desktop"
									class="font-display text-base font-semibold text-sage-deep"
								>
									On this page
								</h2>
								<ol class="mt-3 space-y-2 border-l-2 border-cream-border pl-4">
									{toc.map((h) => (
										<li>
											<a
												href={`#${h.slug}`}
												class="block text-[0.9rem] leading-snug text-ink-muted no-underline hover:text-trust"
											>
												{h.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
			</div>

			{
				relatedRecipes.length > 0 && (
					<section aria-labelledby="guide-recipes" class="mt-16">
						<h2 id="guide-recipes" class="font-display text-2xl font-semibold text-sage-deep">
							Recipes for this phase
						</h2>
						<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
							{relatedRecipes.map((recipe) => (
								<RecipeCard recipe={recipe} />
							))}
						</div>
					</section>
				)
			}

			{
				relatedGuides.length > 0 && (
					<section aria-labelledby="guide-related" class="mt-16">
						<h2 id="guide-related" class="font-display text-2xl font-semibold text-sage-deep">
							Related guides
						</h2>
						<div class="mt-6 grid gap-6 sm:grid-cols-2">
							{relatedGuides.map((g) => (
								<ContentCard
									href={`/guides/${g.id}/`}
									title={g.data.title}
									summary={g.data.summary}
									eyebrow="Guide"
									meta={[`${g.data.readingMinutes} min read`]}
								/>
							))}
						</div>
					</section>
				)
			}

			<div class="mt-16">
				<EmailSignup id="starter-kit" />
			</div>
		</div>
	</article>
</BaseLayout>
