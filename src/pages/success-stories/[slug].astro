---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, isoDate, phaseLabel, publishedOnly } from '../../lib/utils';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export const getStaticPaths: GetStaticPaths = async () => {
	const stories = publishedOnly(await getCollection('stories'));
	return stories.map((story) => ({
		params: { slug: story.id },
		props: { story },
	}));
};

interface Props {
	story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { data } = story;
const { Content } = await render(story);

const url = `/success-stories/${story.id}/`;
const crumbs = [
	{ label: 'Home', href: '/' },
	{ label: 'Success Stories', href: '/success-stories/' },
	{ label: data.personName, href: url },
];

const relatedGuides = (
	await Promise.all(data.relatedGuides.map((id) => getEntry('guides', id)))
).filter((g): g is NonNullable<typeof g> => Boolean(g));
---

<BaseLayout
	title={data.seoTitle ?? data.title}
	description={data.description}
	ogType="article"
	publishedTime={data.publishDate}
	modifiedTime={data.updatedDate}
	schemaNodes={[breadcrumbSchema(crumbs), articleSchema(data, url)]}
>
	<article>
		<div class="border-b border-cream-border bg-cream-sunken">
			<div class="mx-auto max-w-4xl px-5 py-8 sm:py-12">
				<Breadcrumbs crumbs={crumbs} class="mb-6" />

				<p class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-sage-deep">
					Success story
				</p>

				<h1 class="mt-4 font-display text-3xl font-semibold text-sage-deep sm:text-4xl md:text-5xl">
					{data.title}
				</h1>

				<!-- Pull quote: the emotional anchor of the page -->
				<blockquote class="mt-7 border-l-4 border-sage-light pl-5">
					<p class="font-display text-xl leading-relaxed text-sage-deep sm:text-2xl">
						&ldquo;{data.quote}&rdquo;
					</p>
					<footer class="mt-3 text-sm text-ink-muted">
						— {data.personName}, {data.location}
					</footer>
				</blockquote>
			</div>
		</div>

		<div class="mx-auto max-w-4xl px-5 py-12">
			<!-- Structured summary so the outcome is scannable before the narrative -->
			<section aria-labelledby="at-a-glance" class="card p-6">
				<h2 id="at-a-glance" class="font-display text-xl font-semibold text-sage-deep">
					At a glance
				</h2>

				<dl class="mt-4 grid gap-4 sm:grid-cols-3">
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-sage">Timeframe</dt>
						<dd class="mt-1 font-medium text-ink">{data.timeframe}</dd>
					</div>
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-sage">Current phase</dt>
						<dd class="mt-1 font-medium text-ink">{phaseLabel(data.phase)}</dd>
					</div>
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wide text-sage">Location</dt>
						<dd class="mt-1 font-medium text-ink">{data.location}</dd>
					</div>
				</dl>

				<div class="mt-6 border-t border-cream-border pt-5">
					<h3 class="text-xs font-semibold uppercase tracking-wide text-sage">Background</h3>
					<p class="mt-2 leading-relaxed text-ink-muted">{data.background}</p>
				</div>

				<div class="mt-6 grid gap-6 border-t border-cream-border pt-5 sm:grid-cols-2">
					<div>
						<h3 class="text-xs font-semibold uppercase tracking-wide text-sage">Outcomes</h3>
						<ul class="mt-3 space-y-2">
							{
								data.outcomes.map((outcome) => (
									<li class="flex gap-2.5 text-[0.925rem] leading-relaxed text-ink">
										<span class="mt-0.5 shrink-0 text-sage">
											<Icon name="check" size={16} />
										</span>
										<span>{outcome}</span>
									</li>
								))
							}
						</ul>
					</div>

					{
						data.triggersFound.length > 0 && (
							<div>
								<h3 class="text-xs font-semibold uppercase tracking-wide text-sage">
									Triggers identified
								</h3>
								<ul class="mt-3 space-y-2">
									{data.triggersFound.map((trigger) => (
										<li class="flex gap-2.5 text-[0.925rem] leading-relaxed text-ink">
											<span class="mt-0.5 shrink-0 text-amber">
												<Icon name="scale" size={16} />
											</span>
											<span>{trigger}</span>
										</li>
									))}
								</ul>
							</div>
						)
					}
				</div>
			</section>

			<div class="prose prose-gutwise mt-12">
				<Content />
			</div>

			<p class="mt-10 text-sm text-ink-muted">
				Published{' '}
				<time datetime={isoDate(data.publishDate)}>{formatDate(data.publishDate)}</time>
				. Shared with permission, first name only.
			</p>

			{
				relatedGuides.length > 0 && (
					<section aria-labelledby="story-guides" class="mt-14">
						<h2 id="story-guides" class="font-display text-2xl font-semibold text-sage-deep">
							The guides mentioned here
						</h2>
						<div class="mt-6 grid gap-6 sm:grid-cols-2">
							{relatedGuides.map((guide) => (
								<ContentCard
									href={`/guides/${guide.id}/`}
									title={guide.data.title}
									summary={guide.data.summary}
									eyebrow="Guide"
									meta={[`${guide.data.readingMinutes} min read`]}
								/>
							))}
						</div>
					</section>
				)
			}

			<div class="mt-14">
				<EmailSignup id="starter-kit" />
			</div>
		</div>
	</article>
</BaseLayout>
