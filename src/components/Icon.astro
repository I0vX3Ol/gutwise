---
/**
 * Inline SVG icons.
 *
 * Every icon is decorative by default (aria-hidden) because it always sits
 * beside a real text label — WCAG 1.4.1 means meaning is never carried by the
 * glyph or its colour alone. Pass `title` only for the rare standalone case.
 */
interface Props {
	name:
		| 'check'
		| 'scale'
		| 'alert'
		| 'clock'
		| 'users'
		| 'arrow-right'
		| 'search'
		| 'menu'
		| 'close'
		| 'leaf'
		| 'book'
		| 'external'
		| 'mail'
		| 'chevron';
	size?: number;
	class?: string;
	title?: string;
}

const { name, size = 20, class: className = '', title } = Astro.props;

const paths: Record<Props['name'], string> = {
	check: '<path d="M20 6 9 17l-5-5"/>',
	scale:
		'<path d="M12 3v18"/><path d="M5 7h14"/><path d="m5 7-3 6a3 3 0 0 0 6 0Z"/><path d="m19 7 3 6a3 3 0 0 1-6 0Z"/><path d="M8 21h8"/>',
	alert:
		'<circle cx="12" cy="12" r="9"/><path d="M12 8v5"/><path d="M12 16.5h.01"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	users:
		'<path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 20v-2a4 4 0 0 0-3-3.87"/>',
	'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
	menu: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>',
	close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
	leaf: '<path d="M11 20A7 7 0 0 1 4 13c0-6 7-9 16-9 0 9-4 16-9 16Z"/><path d="M4 21c3-6 6-9 12-12"/>',
	book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>',
	external:
		'<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/>',
	mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
};
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden={title ? undefined : 'true'}
	role={title ? 'img' : undefined}
	focusable="false"
>
	{title && <title>{title}</title>}
	<Fragment set:html={paths[name]} />
</svg>
