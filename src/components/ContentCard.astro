---
import Icon from './Icon.astro';

/**
 * Generic index card for guides, product roundups and success stories.
 * Recipes have their own card because they carry time and yield metadata.
 */
interface Props {
	href: string;
	title: string;
	summary: string;
	image?: string;
	imageAlt?: string;
	eyebrow?: string;
	/** Small facts shown under the eyebrow, e.g. "9 min read". */
	meta?: string[];
	tags?: string[];
	eager?: boolean;
	/**
	 * Heading level for the card title. Defaults to 3, since cards usually sit
	 * inside an <h2> section — pass 2 when the grid follows the page <h1>
	 * directly, so the outline never skips a level.
	 */
	level?: 2 | 3 | 4;
}

const {
	href,
	title,
	summary,
	image,
	imageAlt,
	eyebrow,
	meta = [],
	tags = [],
	eager = false,
	level = 3,
} = Astro.props;

const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<article
	class="card group relative flex h-full flex-col overflow-hidden transition-shadow hover:shadow-md"
>
	{
		image && (
			<img
				src={image}
				alt={imageAlt ?? ''}
				width="640"
				height="400"
				loading={eager ? 'eager' : 'lazy'}
				decoding="async"
				class="aspect-[8/5] w-full bg-cream-sunken object-cover"
			/>
		)
	}

	<div class="flex flex-1 flex-col p-5">
		{
			eyebrow && (
				<p class="text-xs font-semibold uppercase tracking-wide text-sage">
					{eyebrow}
				</p>
			)
		}

		<Heading class="mt-1.5 font-display text-xl font-semibold text-sage-deep">
			<a href={href} class="no-underline after:absolute after:inset-0">
				{title}
			</a>
		</Heading>

		{
			meta.length > 0 && (
				<p class="mt-2 text-xs font-medium text-ink-muted">{meta.join(' · ')}</p>
			)
		}

		<p class="mt-2 flex-1 text-[0.925rem] leading-relaxed text-ink-muted">
			{summary}
		</p>

		{
			tags.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-1.5">
					{tags.map((tag) => (
						<li class="rounded-full bg-sage-wash px-2.5 py-1 text-xs font-semibold text-sage-deep">
							{tag}
						</li>
					))}
				</ul>
			)
		}

		<p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-trust">
			Read more
			<Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
		</p>
	</div>
</article>
