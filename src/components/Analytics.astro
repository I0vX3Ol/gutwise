---
/**
 * Analytics: GA4 (consent-gated) + Cloudflare Web Analytics (cookieless).
 *
 * Both IDs come from environment variables, so nothing is hardcoded and the
 * whole block disappears cleanly when the variables are unset — which is what
 * happens on preview branches and local dev.
 *
 * GA4 is not merely consent-*mode* gated, it is consent-*loaded*: gtag.js is
 * never fetched until the visitor actively accepts. Consent Mode alone still
 * sends cookieless pings to Google before any choice is made, which is hard to
 * defend under GDPR; not loading the tag at all is unambiguous. Consent Mode
 * defaults are still set, so the tag starts from "denied" even once loaded.
 *
 * Cloudflare Web Analytics sets no cookies, uses no client-side state and
 * collects no personal data, so it loads without consent — and the privacy
 * policy says so explicitly rather than burying it.
 */
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{ga4Id && <meta name="gutwise:ga4" content={ga4Id} />}

{
	ga4Id && (
		<script>
			// gtag.js is an untyped global that takes variadic arguments, so the
			// shims it needs are declared here rather than in a global .d.ts —
			// this is the only file that touches them.
			declare global {
				interface Window {
					dataLayer: unknown[];
					gtag: (...args: unknown[]) => void;
					/** Called by the consent banner the moment the visitor accepts. */
					gutwiseLoadAnalytics: () => void;
				}
			}

			const el = document.querySelector('meta[name="gutwise:ga4"]');
			const id = el && el.getAttribute('content');

			if (id) {
				window.dataLayer = window.dataLayer || [];

				// gtag.js reads the raw `arguments` object off dataLayer, so this
				// must stay a classic function pushing `arguments` — pushing a rest
				// array instead is not equivalent for every gtag.js code path.
				function gtag(..._args: unknown[]) {
					// eslint-disable-next-line prefer-rest-params
					window.dataLayer.push(arguments);
				}
				window.gtag = gtag;

				// Consent Mode defaults are queued before the tag exists, so even
				// once it loads it starts from denied and upgrades explicitly.
				gtag('consent', 'default', {
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
					analytics_storage: 'denied',
					functionality_storage: 'granted',
					security_storage: 'granted',
				});

				let loaded = false;

				window.gutwiseLoadAnalytics = () => {
					if (loaded) return;
					loaded = true;

					gtag('consent', 'update', { analytics_storage: 'granted' });
					gtag('js', new Date());
					gtag('config', id, { anonymize_ip: true, send_page_view: true });

					const s = document.createElement('script');
					s.async = true;
					s.src =
						'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
					document.head.appendChild(s);
				};

				// Returning visitors who already accepted get the tag immediately.
				// Everyone else gets nothing until they press Accept — no tag fetch,
				// no cookieless ping, nothing.
				if (localStorage.getItem('gutwise:consent') === 'granted') {
					window.gutwiseLoadAnalytics();
				}
			}
		</script>
	)
}

{
	cfToken && (
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={JSON.stringify({ token: cfToken })}
		/>
	)
}
