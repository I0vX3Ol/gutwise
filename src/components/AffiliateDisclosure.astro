---
import { AFFILIATE_DISCLOSURE } from '../consts';
import Icon from './Icon.astro';

/**
 * FTC-compliant affiliate disclosure.
 *
 * Must appear above the fold and before the first affiliate link on any page
 * that carries one — a footer-only disclosure does not meet the FTC's "clear
 * and conspicuous" standard.
 */
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<aside
	aria-label="Affiliate disclosure"
	class:list={[
		'flex items-start gap-3 rounded-card border border-cream-border bg-cream-sunken p-4',
		className,
	]}
>
	<span class="mt-0.5 shrink-0 text-sage">
		<Icon name="alert" size={18} />
	</span>
	<p class="text-sm leading-relaxed text-ink-muted">
		<strong class="font-semibold text-sage-deep">Disclosure:</strong>{' '}
		{AFFILIATE_DISCLOSURE}{' '}
		<a
			href="/affiliate-disclosure/"
			class="text-trust underline decoration-1 underline-offset-2"
		>
			Full disclosure
		</a>
		.
	</p>
</aside>
