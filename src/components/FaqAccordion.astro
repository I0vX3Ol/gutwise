---
import Icon from './Icon.astro';

/**
 * FAQ list built on native <details>/<summary>.
 *
 * Native disclosure elements give keyboard operation, expanded-state
 * announcement and find-in-page expansion for free, and they work with
 * JavaScript disabled — all of which a div-and-ARIA implementation has to
 * reimplement and usually gets wrong.
 *
 * The FAQPage structured data is emitted by the page, not here, so the same
 * source array drives both the markup and the schema.
 */
interface Props {
	items: { question: string; answer: string }[];
	/** Opens the first item, useful when the FAQ is the main content. */
	openFirst?: boolean;
	class?: string;
}

const { items, openFirst = false, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-cream-border', className]}>
	{
		items.map((item, i) => (
			<details class="group py-1" open={openFirst && i === 0}>
				<summary
					class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-md py-4 font-display text-lg font-semibold text-sage-deep marker:content-none"
				>
					<span>{item.question}</span>
					<span class="mt-1 shrink-0 text-sage transition-transform duration-200 group-open:rotate-180">
						<Icon name="chevron" size={20} />
					</span>
				</summary>
				<div class="pb-5 pr-8">
					<p class="leading-relaxed text-ink">{item.answer}</p>
				</div>
			</details>
		))
	}
</div>

<style>
	/* Safari renders a disclosure triangle unless this pseudo-element is cleared. */
	summary::-webkit-details-marker {
		display: none;
	}
</style>
